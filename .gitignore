# .gitignore — KDesigns Blooms & Styles
# ============================================================

# NEVER commit credentials or secrets
.env
.env.local
.env.production

# Database credentials live in .env, not in PHP.
# config/db.php is a PDO helper with no secrets and should be committed.

# Application storage (logs, rate limits, uploads)
storage/logs/
storage/rate_limits/
storage/uploads/

# Node / build artifacts
node_modules/
package-lock.json
*.lock

# PHP dependencies
vendor/
composer.lock
composer.phar

# IDE and OS artifacts
.vscode/
.idea/
*.DS_Store
Thumbs.db

# PHP error logs
*.log
php_errors.log
.phpunit.cache/

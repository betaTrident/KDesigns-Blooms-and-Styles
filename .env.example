# Copy this file to .env before running the app or scripts/setup-database.php.
#
# Login authenticates against the users table (see login.php / signup.php).
# Demo users, catalog, and sample orders live in database/seeds.sql (hashes only, no plaintext passwords).
#
# Refresh seeds from this machine's live database:
#   C:\xampp\php\php.exe scripts/export-seeds.php
# Restore on another machine after schema:
#   C:\xampp\php\php.exe scripts/setup-database.php

# MariaDB (XAMPP labels this "MySQL"). DB_PASS empty is the XAMPP default — local only, never in production.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kdesigns
DB_USER=root
DB_PASS=

# Optional seed identity labels (emails should match database/seeds.sql).
ADMIN_EMAIL=admin@kdesigns.ph
ADMIN_NAME=Admin
CUSTOMER_EMAIL=maja@kdesigns.ph
CUSTOMER_NAME=Maja

# Optional. If set, setup-database.php overwrites that user's hash after loading seeds.sql.
# Leave empty to keep the hashes already stored in database/seeds.sql.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ============================================================
#  KDesigns Blooms & Styles — public/ webroot
# ============================================================

Options -Indexes
ServerSignature Off
DirectoryIndex index.php

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git(/.*)?$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Tailwind is compiled to /assets/css/app.css. Font Awesome + Google Fonts remain CDN.
    # 'unsafe-inline' remains for a few style attributes and the storefront filter script until those move fully.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self';"
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # HSTS — do not enable here on localhost HTTP.
    # PHP sends HSTS from kd_send_security_headers() when APP_ENV=production on HTTPS.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

<IfModule mod_php.c>
    php_flag  display_errors         Off
    php_flag  display_startup_errors Off
    php_value error_reporting        0
    php_flag  log_errors             On
    php_flag  expose_php             Off
    php_flag  allow_url_fopen        Off
    php_flag  allow_url_include      Off
    php_flag  session.use_strict_mode      On
    php_flag  session.cookie_httponly      On
    php_flag  session.cookie_samesite      Strict
    php_value session.gc_maxlifetime       3600
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg  "access plus 1 month"
    ExpiresByType image/jpg   "access plus 1 month"
    ExpiresByType image/png   "access plus 1 month"
    ExpiresByType image/gif   "access plus 1 month"
    ExpiresByType image/webp  "access plus 1 month"
    ExpiresByType text/css    "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
</IfModule>
